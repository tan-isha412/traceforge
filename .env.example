# Copy to .env. Default targets the PostgreSQL container from docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://traceforge:traceforge@localhost:5432/traceforge

# No Docker? Use a local SQLite file instead:
# DATABASE_URL=sqlite:///./traceforge.db

# Shared secret the agents send as X-API-Key (also needed for POST /ml/train).
# Leave empty only for local development. Agents read it from TRACEFORGE_API_KEY.
API_KEY=change-me

# Timestamps are stored in UTC. This zone defines "night" for the ML model and the seeder.
TIMEZONE=Asia/Kolkata

# Production: store only the key's SHA-256 instead of API_KEY (python -m server.manage hash-key).
# API_KEY_HASH=

# One key per agent machine, each accepted only for events naming that machine:
#   python -m server.manage agent-key LAB-PC-01     -> prints the agent's key and the line to add here
# AGENT_KEYS=LAB-PC-01=<sha256>,LAB-PC-02=<sha256>
# Refuse the shared API_KEY on /events/ingest once every agent has its own key.
REQUIRE_AGENT_KEYS=false

# Database password used by docker-compose (the server's DATABASE_URL follows it).
# POSTGRES_PASSWORD=

# Investigator logins and roles. Create the first admin with: python -m server.manage create-user admin --role admin
AUTH_ENABLED=false

# Browser origins allowed to call the API (the dashboard's address), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Behavioural model: iforest (Isolation Forest) or ocsvm (One-Class SVM).
ML_ALGORITHM=iforest

# Retrain on stored history every N hours (0 = only when POST /ml/train is called).
RETRAIN_INTERVAL_HOURS=0

# A copy this large to a USB storage device is flagged as possible exfiltration.
EXFIL_THRESHOLD_MB=500

# HTTPS for the API: python -m server.manage tls-init --host <this server's IP or name>, then
# TLS_CERT_FILE=certs/server.crt
# TLS_KEY_FILE=certs/server.key
# Set instead when a reverse proxy in front of the server handles HTTPS:
# TLS_TERMINATED_BY_PROXY=true

# Digital signatures on exports and attestations. The RSA key pair is created on first start in
# server/model_artifacts/signing_key.pem (or SIGNING_KEY_PATH). With a passphrase the private key is
# stored encrypted (PBKDF2-HMAC-SHA256 -> AES-256-CBC). Losing the passphrase means a new key.
# SIGNING_KEY_PATH=
# SIGNING_KEY_PASSPHRASE=

# Failed logins allowed per username / client address in the window before /auth/login answers 429.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Agent side (set on each agent machine, not the server):
#   TRACEFORGE_TYPING_WATCH_S=30   how long to watch keystroke timing after a keyboard is plugged in
#   TRACEFORGE_SAMPLE_S=2          how often attached storage I/O counters are sampled

# Where the trained model is saved (default server/model_artifacts/iforest.joblib).
# Give real data its own file so the demo model is kept, e.g. server/model_artifacts/real.joblib
# MODEL_PATH=
